# =============================================================================
# Cupqy Web — variáveis de ambiente
#
# Copie para ".env" (ou ".env.local") e preencha. NUNCA versione o arquivo com valores reais.
#
# ATENÇÃO: toda variável com prefixo VITE_ é embutida no JavaScript enviado ao navegador.
# Coloque aqui SOMENTE valores públicos. Nunca use:
#   - a service_role key / secret key do Supabase;
#   - a senha do PostgreSQL;
#   - credenciais privadas do Mercado Pago, chaves do Resend ou segredos de webhook.
# =============================================================================

# URL base da API Express (sem barra final e sem /api/v1).
#   Desenvolvimento: API local (porta padrão do cupqy-server = 3333)
#   Produção: endereço público no Render (ex.: https://cupqy-api.onrender.com)
VITE_API_BASE_URL=http://localhost:3333

# Supabase → Project Settings → API (use o projeto de homologação "cupqy-hml" no desenvolvimento)
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
# Chave PÚBLICA: "publishable" (sb_publishable_...) ou, em projetos antigos, a chave legada "anon".
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# (Opcional) URL pública do front-end usada nos links de e-mail do Supabase Auth
# (confirmação de cadastro e redefinição de senha). Padrão: a origem atual do navegador.
# VITE_APP_URL=https://cupqy.vercel.app
